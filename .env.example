DOMAIN=benshu.example.ru
LETSENCRYPT_EMAIL=you@example.ru
# http — до получения сертификата; https — после (скрипт get_cert.sh переключит сам)
NGINX_MODE=http

# Метод по умолчанию: llm (если ключа нет — автоматически context) | context | first_sense
BENSHU_METHOD=llm

# LLM с OpenAI-совместимым API (chat/completions).
# Вариант YandexGPT (Yandex AI Studio): нужен API-ключ сервисного аккаунта
# с ролью ai.languageModels.user и ID каталога (folder_id).
LLM_BASE_URL=https://ai.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_AUTH_PREFIX="Api-Key "
LLM_PROJECT=<folder_id>
LLM_MODEL=gpt://<folder_id>/yandexgpt/latest
# Для провайдеров с Bearer-ключом: LLM_AUTH_PREFIX="Bearer " и уберите LLM_PROJECT
LLM_TIMEOUT=8

# Демо-переключатель режима A/B в шапке. Для настоящего эксперимента поставьте 0.
BENSHU_DEMO_SWITCH=1
CORS_ORIGINS=*
